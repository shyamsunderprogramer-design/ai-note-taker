{
  "name": "ai-note-taker",
  "version": "1.0.0",
  "description": "AI-powered voice note taker with stealth mode",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder -mwl",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "ai",
    "notes",
    "voice",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.ainotetaker.app",
    "productName": "AI Note Taker",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "shyamsunderprogramer-design",
      "repo": "ai-note-taker",
      "releaseType": "release"
    },
    "signAndEditExecutable": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Note Taker",
      "license": "../LICENSE",
      "artifactName": "${productName}-Setup-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "assets",
      "category": "Utility",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "files": [
      "main.js",
      "preload.js",
      "stealth.js",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "../renderer",
        "to": "renderer",
        "filter": ["**/*"]
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "../AINT_Venv",
        "to": "AINT_Venv",
        "filter": ["**/*"]
      }
    ],
    "asarUnpack": [
      "node_modules/electron-updater/**"
    ],
    "extraMetadata": {
      "main": "main.js"
    }
  },
  "dependencies": {
    "electron-log": "^5.2.4",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1"
  }
}
