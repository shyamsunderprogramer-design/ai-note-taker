# =============================================================================
# ANT (AI Note Taker) — Environment Variables Example
# =============================================================================
# Copy this file to `.env` and fill in real values for local development.
#
#   cp .env.example .env
#
# In production (Render), set these in the Render dashboard or via render.yaml
# (sync: false keys). NEVER commit a real `.env` — it is gitignored.
#
# This file lists every env var the backend reads. Optional vars are marked
# (optional). Required vars have no value set here.
# =============================================================================


# ── Runtime mode ────────────────────────────────────────────────────────────

# Enables cloud-mode optimizations (smaller pool, lighter deps).
# Set to "true" on Render / cloud, "false" for local dev.
CLOUD_MODE=false

# Set to "true" to force SQLite even if DATABASE_URL is set (useful for tests).
USE_SQLITE=false

# Mark this environment ("development", "staging", "production") for log
# routing and feature flags.
ENVIRONMENT=development


# ── Database ────────────────────────────────────────────────────────────────

# PostgreSQL connection URL. Required in production. Example:
#   postgresql+asyncpg://user:password@host:5432/dbname
# If unset and USE_SQLITE=false, the app falls back to the bundled SQLite
# database at backend/data/ainotetaker.db.
DATABASE_URL=

# Path where audit logs are written (one JSON line per event).
AUDIT_LOG_DIR=backend/data/audit_logs


# ── Auth & security ─────────────────────────────────────────────────────────

# JWT signing secret. REQUIRED for stable auth tokens across restarts.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Fernet symmetric key for encrypting API keys at rest. REQUIRED for the
# BYOK (Bring Your Own Key) feature. Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Set to "true" to enforce authentication on protected endpoints.
# Set to "false" only for local development.
AUTH_REQUIRED=true

# Set to "true" to redirect HTTP→HTTPS and add HSTS headers. Off in dev
# (where you'd self-sign), on behind Render/Vercel TLS termination.
HTTPS_REQUIRED=false

# HSTS max-age in seconds (default 1 year). Only meaningful when
# HTTPS_REQUIRED=true.
HSTS_MAX_AGE=31536000

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Refresh token lifetime in days.
REFRESH_TOKEN_EXPIRE_DAYS=30


# ── CORS ────────────────────────────────────────────────────────────────────

# When "true", allow requests from ANY origin. NEVER enable in production.
# Default in code is "false" — only flip to "true" for local debugging.
CORS_ALLOW_ALL=false

# Comma-separated list of allowed origins for production. Example:
#   https://ant-note-taker.vercel.app,https://www.ainotetaker.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# (Legacy) Single Vercel URL. Superseded by CORS_ORIGINS but still read
# by older code paths. Safe to leave blank.
CORS_VERCEL_URL=


# ── Rate limiting ───────────────────────────────────────────────────────────

# Public (unauthenticated) requests per minute per IP.
RATE_LIMIT_PUBLIC=60

# Authenticated requests per minute per user.
RATE_LIMIT_AUTHED=300

# Sensitive endpoints (login, register, password reset) per minute per IP.
RATE_LIMIT_SENSITIVE=10

# Per-minute limit (used as a fallback when PUBLIC/AUTHED aren't set).
RATE_LIMIT_PER_MINUTE=60


# ── Cache (Redis) ───────────────────────────────────────────────────────────

# Set to "true" to enable Redis-backed caching (recommended for production).
# When "false", the in-process LRU cache is used (works for single-worker).
REDIS_ENABLED=false

# Redis connection URL, e.g. redis://localhost:6379/0
REDIS_URL=

# Cache TTLs in seconds. Used by modules/ai/cache_manager.py.
CACHE_TTL_DEFAULT=300
CACHE_TTL_ANALYTICS=60
CACHE_TTL_PROVIDER=3600


# ── AI: local Ollama ────────────────────────────────────────────────────────

# Ollama base URL. On Render free tier the local server is not available;
# users must rely on cloud providers or self-host.
OLLAMA_URL=http://localhost:11434

# Ollama cloud endpoint and API key (for cloud models with :cloud suffix).
# Required only if you want the `cloud` mode or any `*:cloud` model to work.
# Sign up at https://ollama.com to get a key.
OLLAMA_CLOUD_URL=https://ollama.com
OLLAMA_CLOUD_API_KEY=

# Per-mode model selection. The defaults below are tuned for the locally
# installed ollama models — see `ollama list` to confirm yours match.
#
#   Mode           Default            Why
#   ─────────────  ─────────────────  ──────────────────────────────────────
#   default        qwen3.5:9b         Best general-purpose (vision + tools)
#   adaptive       qwen3.5:9b         Same as default
#   universal      qwen3.5:9b         Same
#   code           qwen3.5:9b         Tool-use capable, strong code gen
#   interview      gemma4:e4b         Strong technical depth
#   reasoning      gemma4:e4b         Best math/logic of the 3
#   fast           lfm2.5:latest      Fastest 8.5B local
#   turbo          lfm2.5:latest      Same (turbo = fast, fewer tokens)
#   cloud          minimax-m3:cloud   Cloud-quality; needs OLLAMA_CLOUD_API_KEY
#
# To use a different model, pull it first:
#   ollama pull <model-name>
# Then override the env var here. The backend will start without the
# model present and fall back to a heuristic response — but you'll see
# a startup warning telling you which models are missing.
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_MODEL_FAST=lfm2.5:latest
OLLAMA_MODEL_CLOUD=minimax-m3:cloud
OLLAMA_MODEL_REASONING=gemma4:e4b
OLLAMA_MODEL_CODE=qwen3.5:9b
OLLAMA_MODEL_INTERVIEW=gemma4:e4b
OLLAMA_MODEL_UNIVERSAL=qwen3.5:9b
OLLAMA_MODEL_ADAPTIVE=qwen3.5:9b
OLLAMA_MODEL_TURBO=lfm2.5:latest

# AI behavior tuning.
AI_TEMPERATURE=0.1
AI_TIMEOUT=60

# Token caps for the "instant" and "turbo" response modes.
TURBO_MAX_TOKENS=150
INSTANT_MAX_TOKENS=64


# ── AI: cloud providers (BYOK) ──────────────────────────────────────────────
# Users can supply their own keys via the UI; these are server-wide fallbacks
# and demo keys. Set at least one in production.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
PERPLEXITY_API_KEY=
BRAVE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# ── AI: additional providers (optional) ──────────────────────────────────────
# Each enables a new provider in the multi-provider routing. Leave empty to
# keep that provider disabled.

# Mistral AI — https://console.mistral.ai/
MISTRAL_API_KEY=

# Cohere — https://dashboard.cohere.ai/
COHERE_API_KEY=

# HuggingFace Inference API — https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Hosted embedding API key (used when EMBEDDING_PROVIDER=hosted).
# If unset, the local sentence-transformers model is used.
EMBEDDING_API_KEY=


# ── Embeddings & classification (saves RAM to disable) ──────────────────────

# Set to "false" on Render free tier to save ~120MB RAM. Disables semantic
# search and cognitive graph memory layer.
EMBEDDING_ENABLED=true

EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=auto
EMBEDDING_CACHE_SIZE=10000
EMBEDDING_PROVIDER=local
SEMANTIC_SEARCH_THRESHOLD=0.3

# Set to "false" to save ~300MB RAM. Disables smart question classifier.
CLASSIFIER_ENABLED=true
CLASSIFIER_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
CLASSIFIER_DEVICE=auto


# ── Cognitive graph (Neo4j) ─────────────────────────────────────────────────

# Neo4j connection. Required for the cognitive graph module.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
# Set a strong password before connecting. Example:
#   NEO4J_PASSWORD=your_secure_password
NEO4J_PASSWORD=


# ── Webhooks ────────────────────────────────────────────────────────────────

# HMAC signing secret for outgoing webhooks. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=


# ── SSO (Google, Microsoft, SAML, OIDC) ────────────────────────────────────

# Google OAuth client. Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft / Azure AD OAuth client. Create at https://portal.azure.com → App Registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# SAML SSO (optional, for enterprise customers). The IdP-specific values
# (IDP_ENTITY_ID, IDP_SSO_URL, IDP_X509_CERT) and SP-specific values
# (SP_ENTITY_ID, SP_ACS_URL) are read from the SSO module's own config.
# See backend/routes/sso.py for the full list.
SSO_SAML_IDP_ENTITY_ID=
SSO_SAML_IDP_SSO_URL=
SSO_SAML_IDP_X509_CERT=
SSO_SAML_SP_ENTITY_ID=
SSO_SAML_SP_ACS_URL=

# OIDC SSO (optional, for enterprise customers). Generic OIDC config
# alongside the first-party Google/Microsoft flows above.
SSO_OIDC_ISSUER=
SSO_OIDC_CLIENT_ID=
SSO_OIDC_CLIENT_SECRET=
SSO_OIDC_REDIRECT_URI=

# Public origin for OAuth/SAML callbacks (e.g. https://ant.ainotetaker.com).
# In dev, defaults to http://localhost:8000.
SSO_BASE_URL=http://localhost:8000

# Google Calendar integration (separate from Google SSO).
GOOGLE_CALENDAR_CLIENT_ID=


# ── CRM integrations ────────────────────────────────────────────────────────

HUBSPOT_API_KEY=
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_INSTANCE_URL=

# ── Workspace integrations (Notion, Jira, Slack, Teams) ──────────────────────

NOTION_API_KEY=
NOTION_DATABASE_ID=

JIRA_API_KEY=
JIRA_URL=
JIRA_USERNAME=

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

TEAMS_WEBHOOK_URL=


# ── Phone / VoIP (Twilio, optional) ─────────────────────────────────────────
# Phone/VoIP is a stub route (backend/routes/phone.py) waiting for the
# underlying provider. These env vars will be honored once the integration
# lands. Safe to leave empty today.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=


# ── Auto-apply (job board automation, optional) ─────────────────────────────
# The auto-apply route is a stub; set these when a browser-automation backend
# (Playwright / Puppeteer) is wired in.

AUTO_APPLY_HEADLESS=true
AUTO_APPLY_USER_DATA_DIR=


# ── Whisper STT (local) ─────────────────────────────────────────────────────

# Model size for faster-whisper: tiny | base | small | medium | large-v3
WHISPER_MODEL=base


# ── Local development overrides ─────────────────────────────────────────────

# Show extra debug output in logs.
DEBUG=false

# Bind port (used by start_server.py and Dockerfile).
PORT=8000

# Override the bundled meeting-templates directory. By default the CRM
# meeting_templates module looks under backend/modules/crm/templates/.
# Set this to an absolute path to point at a custom template folder.
ANT_MEETING_TEMPLATES_DIR=

# Override the voice storage directory (voice clones, RVC models,
# training data). Default: backend/data/voice/. Set to a persistent
# volume in production so voice clones survive deploys.
ANT_VOICE_STORAGE_DIR=


# =============================================================================
# Notes
# =============================================================================
# 1. Required in production: DATABASE_URL (or USE_SQLITE=true),
#    JWT_SECRET_KEY, ENCRYPTION_KEY, at least one AI provider key.
# 2. Never commit a real `.env` — `.env` is in `.gitignore` at the repo root.
# 3. To bootstrap a new env file from this template:
#       cp .env.example .env
#       python3 -c "import secrets; print('JWT_SECRET_KEY=' + secrets.token_urlsafe(64))" >> .env
#       python3 -c "from cryptography.fernet import Fernet; print('ENCRYPTION_KEY=' + Fernet.generate_key().decode())" >> .env
# 4. Render-specific keys (sync: false in render.yaml) override these
#    values at runtime.
# 5. The frontend (apps/web) does not read this file directly. It calls the
#    backend at the URL passed as the global `API_BASE` (default
#    `http://127.0.0.1:8000`). Override by injecting a `<script>` tag that
#    sets `window.API_BASE = 'https://api.your-domain.com'` BEFORE
#    `app.js` loads. There is no VITE_ contract on the frontend.
# =============================================================================
