{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "node --version",
  "buildCommand": "npm run site:build",
  "outputDirectory": "apps/landing/dist",
  "rewrites": [],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": false },
    { "source": "/product.html", "destination": "/", "permanent": false },
    { "source": "/app", "destination": "/#download", "permanent": false },
    { "source": "/browser-app.html", "destination": "/#download", "permanent": false },
    { "source": "/signin", "destination": "/#download", "permanent": false },
    { "source": "/signin.html", "destination": "/#download", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; worker-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'" }
      ]
    },
    { "source": "/sw.js", "headers": [
      { "key": "Cache-Control", "value": "no-store" },
      { "key": "Service-Worker-Allowed", "value": "/" }
    ] }
  ],
  "trailingSlash": false
}
