# AI Note Taker - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ═══════════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════════
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ainotetaker
USE_SQLITE=true
FORCE_SQLITE=true

# ═══════════════════════════════════════════════════════════════
# AUTHENTICATION & SECURITY
# ═══════════════════════════════════════════════════════════════
AUTH_REQUIRED=true
ENCRYPTION_KEY=replace-with-32-char-encryption-key

# ═══════════════════════════════════════════════════════════════
# AI PROVIDERS
# ═══════════════════════════════════════════════════════════════
OLLAMA_URL=http://localhost:11434
OLLAMA_CLOUD_URL=https://ollama.com
OLLAMA_CLOUD_API_KEY=your-ollama-cloud-api-key

# Optional cloud AI providers (uncomment to enable)
# OPENAI_API_KEY=sk-YOUR-OPENAI-API-KEY-HERE
# ANTHROPIC_API_KEY=sk-ant-YOUR-ANTHROPIC-API-KEY-HERE
# GOOGLE_API_KEY=YOUR-GOOGLE-API-KEY-HERE
# GROQ_API_KEY=YOUR-GROQ-API-KEY-HERE

# Model configuration
DEFAULT_MODEL=qwen2.5:1.5b
MODEL_FAST=qwen2.5:1.5b
MODEL_CLOUD=minimax-m2.7:cloud

# ═══════════════════════════════════════════════════════════════
# EMBEDDING & CLASSIFICATION (ML features)
# ═══════════════════════════════════════════════════════════════
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=auto
EMBEDDING_PROVIDER=local
EMBEDDING_CACHE_SIZE=10000

CLASSIFIER_ENABLED=true
CLASSIFIER_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
CLASSIFIER_DEVICE=auto

SEMANTIC_SEARCH_THRESHOLD=0.3

# ═══════════════════════════════════════════════════════════════
# NEO4J (optional - for cognitive graph features)
# ═══════════════════════════════════════════════════════════════
# NEO4J_URI=bolt://localhost:7687
# NEO4J_PASSWORD=your-neo4j-password

# ═══════════════════════════════════════════════════════════════
# REDIS (optional - for session caching & rate limiting)
# ═══════════════════════════════════════════════════════════════
# REDIS_URL=redis://localhost:6379

# ═══════════════════════════════════════════════════════════════
# HTTPS & CORS (production settings)
# ═══════════════════════════════════════════════════════════════
HTTPS_REQUIRED=false
CORS_ALLOW_ALL=true
# CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ═══════════════════════════════════════════════════════════════
# RATE LIMITING
# ═══════════════════════════════════════════════════════════════
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_AUTHED=200
RATE_LIMIT_SENSITIVE=20

# ═══════════════════════════════════════════════════════════════
# GITHUB TOKEN (for browser extension - optional)
# ═══════════════════════════════════════════════════════════════
# GH_TOKEN=YOUR-GITHUB-TOKEN-HERE