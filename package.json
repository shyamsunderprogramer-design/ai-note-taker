{
  "name": "ant-monorepo",
  "version": "2.1.0",
  "private": true,
  "description": "ANT (AI Note Taker) \u2014 multi-platform monorepo. Privacy-first AI notepad with Electron desktop, web SPA, mobile (React Native), Chrome/browser extensions, all backed by a FastAPI Python backend.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "electron",
    "mobile",
    "e2e",
    "vendor/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "benchmark:web": "node qa/performance/web/vite-build-time.mjs",
    "benchmark:browser": "node qa/performance/web/browser-smoke.mjs",
    "web:dev": "npm --workspace ant-web run dev",
    "web:build": "npm --workspace ant-web run build",
    "web:preview": "npm --workspace ant-web run preview",
    "electron:start": "npm --workspace ai-note-taker start",
    "electron:dev": "npm --workspace ai-note-taker run dev",
    "electron:build": "npm --workspace ai-note-taker run build",
    "electron:build:win": "npm --workspace ai-note-taker run build:win",
    "electron:build:mac": "npm --workspace ai-note-taker run build:mac",
    "electron:build:linux": "npm --workspace ai-note-taker run build:linux",
    "electron:icons": "npm --workspace ai-note-taker run icons",
    "mobile:start": "npm --workspace ant-mobile start",
    "mobile:android": "npm --workspace ant-mobile run android",
    "mobile:ios": "npm --workspace ant-mobile run ios",
    "mobile:test": "npm --workspace ant-mobile test",
    "mobile:lint": "npm --workspace ant-mobile run lint",
    "e2e:test": "npm --workspace ant-e2e-tests test",
    "e2e:test:ui": "npm --workspace ant-e2e-tests run test:ui",
    "e2e:install:browsers": "npm --workspace ant-e2e-tests run install:browsers",
    "extension:package": "npm --workspace ant-chrome-extension run package",
    "extension:lint": "npm --workspace ant-chrome-extension run lint",
    "lint": "npm run mobile:lint && npm run extension:lint",
    "test": "npm run e2e:test",
    "build": "npm run web:build && npm run electron:build",
    "test:security": "node --test qa/security/*.test.cjs"
  },
  "devDependencies": {
    "eslint": "^8.56.0"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "fast-uri": "3.1.8",
    "ip-address": "10.5.1",
    "@humanfs/node": "0.16.8",
    "js-yaml@^4.0.0": "4.3.2",
    "js-yaml@^3.0.0": "3.15.2",
    "brace-expansion@^1.0.0": "1.1.21",
    "brace-expansion@^2.0.0": "2.1.7",
    "brace-expansion@>=3.0.0": "5.0.12",
    "extract-zip": "npm:@electron-internal/extract-zip@1.0.5",
    "@electron/get": "5.1.0",
    "decode-uri-component": "file:vendor/ant-decode-uri-compat-1.0.0.tgz",
    "image-size": "file:vendor/ant-image-size-compat-1.0.0.tgz",
    "braces": "file:vendor/ant-braces-safe-1.0.0.tgz",
    "ip": "file:vendor/ant-ip-safe-1.0.0.tgz",
    "fast-xml-parser": "5.11.2",
    "argparse": "2.0.1"
  }
}
